{
  "uns": {
    "graphql": "http://localhost:3200/graphql",
    "rest": "http://localhost:3200/api",
    "email": "user@example.com",
    "password": {
      "provider": "env",
      "key": "UNS_PASSWORD"
    },
    "processName": "uns-archiver",
    "instanceMode": "handover",
    "handover": true,
    "jwksWellKnownUrl": "http://localhost:3200/api/.well-known/jwks.json",
    "kidWellKnownUrl": "http://localhost:3200/api/.well-known/kid",
    "supervisor": {
      "enabled": false
    }
  },
  "infra": {
    "host": "localhost"
  },
  "input": {
    "host": "localhost"
  },
  "archiver": {
    "inactiveBufferMax": 2000,
    "inactiveBufferMaxAgeMs": 300000,
    "traceIngest": false
  },
  "questdb": {
    "configurationString": "http::addr=localhost:9000;auto_flush=on",
    "dataStorage": [
      {
        "tablePrefix": "uns_enterprise",
        "topic": "enterprise/#",
        "ingestMode": "dedup"
      }
    ]
  }
}
