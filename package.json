{
  "name": "uns-archiver",
  "version": "5.2.0",
  "description": "UNS DataHub add-on that archives UNS data and table packets to QuestDB.",
  "private": true,
  "license": "MIT",
  "author": "Aljoša Vister",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uns-datahub/uns-archiver.git"
  },
  "homepage": "https://github.com/uns-datahub/uns-archiver#readme",
  "bugs": {
    "url": "https://github.com/uns-datahub/uns-archiver/issues"
  },
  "unsDatahub": {
    "schemaVersion": 1,
    "kind": "addon",
    "controllerCompatibility": ">=7.1 <8"
  },
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "verify": "pnpm run test && pnpm run typecheck && pnpm run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch src/index.ts",
    "generate-config-schema": "node ./node_modules/@uns-kit/core/dist/tools/generate-config-schema.js",
    "generate-codegen": "graphql-code-generator --require dotenv/config --config codegen.ts",
    "refresh-uns": "node ./node_modules/@uns-kit/core/dist/tools/refresh-uns.js",
    "check-release-version": "node scripts/check-release-version.mjs"
  },
  "dependencies": {
    "@questdb/nodejs-client": "^4.2.0",
    "@uns-kit/api": "^3.0.5",
    "@uns-kit/core": "^3.0.5",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "^4.5.2",
    "@types/node": "^22.19.1",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@smithy/config-resolver": "4.6.12",
      "fast-xml-parser": "5.10.1",
      "lodash": "4.18.1",
      "protobufjs": "7.6.5",
      "simple-git": "3.36.0",
      "thrift": "0.23.0",
      "underscore": "1.13.8",
      "undici": "7.28.0",
      "uuid": "11.1.1"
    }
  },
  "packageManager": "pnpm@10.30.3"
}
